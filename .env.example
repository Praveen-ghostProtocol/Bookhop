# Copy to .env and fill in. **Never commit .env.** No secret belongs in the repo
# (THREAT-MODEL §1 V13). On the pilot box these are systemd unit Environment=
# lines, which is the one secret store this project has (INFRA.md).

# --- Database -------------------------------------------------------------
# postgres (production, ADR-001 §2.2) or sqlite (local dev on a machine without
# Postgres or Docker). bookhop/settings/dev.py defaults to sqlite;
# bookhop/settings/prod.py refuses anything but postgres.
#
# READ company/architecture/ENGINE-DIVERGENCE.md before trusting a test run on
# sqlite: not every correctness property of this schema is verified there.
BOOKHOP_DB_ENGINE=sqlite
# BOOKHOP_DB_NAME=bookhop
# BOOKHOP_DB_USER=bookhop
# BOOKHOP_DB_PASSWORD=
# BOOKHOP_DB_HOST=127.0.0.1
# BOOKHOP_DB_PORT=5432

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
BOOKHOP_SECRET_KEY=
BOOKHOP_ALLOWED_HOSTS=localhost,127.0.0.1
BOOKHOP_LOG_LEVEL=INFO

# --- Not yet used ---------------------------------------------------------
# Listed so nobody invents a different name for them later.
# BOOKHOP_EMAIL_HOST=                 # S1, transactional email
# BOOKHOP_EMAIL_HOST_USER=
# BOOKHOP_EMAIL_HOST_PASSWORD=
# BOOKHOP_TOMBSTONE_EMAIL_SALT=       # S1, DATA-MODEL §10.1: a server-side
#                                     # secret that is NOT stored in the database
# BOOKHOP_TOMBSTONE_EMAIL_SALT_VERSION=v1   # S1, COMPLIANCE.md §7 row 24: the
#                                     # version a tombstone records, so a salt
#                                     # can be retired or rotated
# BOOKHOP_PUBLIC_ORIGIN=              # S1, e.g. https://bookhop.example. The
#                                     # origin an emailed sign-in link is
#                                     # absolute against. No default: localhost
#                                     # would email a dead link.
# BOOKHOP_VAPID_PRIVATE_KEY=          # S7, web push
# BOOKHOP_METRICSZ_TOKEN=             # S8, /metricsz
